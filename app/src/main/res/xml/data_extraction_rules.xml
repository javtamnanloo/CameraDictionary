<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: back up and transfer only the saved-words database (your Leitner
     box). Settings and caches are not copied. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
